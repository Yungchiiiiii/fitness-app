# Frontend-safe Supabase values. The publishable/anon key is protected by RLS,
# but the secret/service-role key must never be used here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# AI keys belong only in Supabase Edge Function secrets.
GEMINI_API_KEY=put-your-gemini-api-key-here
GROQ_API_KEY=put-your-groq-api-key-here
